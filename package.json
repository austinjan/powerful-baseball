{
  "name": "powerful-baseball-guide",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/powerful-baseball vinext build && mv dist/client/powerful-baseball/_next dist/client/_next && rmdir dist/client/powerful-baseball && touch dist/client/.nojekyll",
    "start": "vinext start",
    "test": "node --experimental-strip-types --test app/special-abilities/*.test.ts app/reincarnated-players/*.test.ts"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13"
  },
  "type": "module"
}
